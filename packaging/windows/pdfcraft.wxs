<?xml version="1.0" encoding="utf-8"?>
<!--
  XueLuoPDF MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional), an App Paths entry, XueLuoPDF registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default), and "Edit with XueLuoPDF" on PDF files'
  right-click menu (on by default, optional). Files opened with XueLuoPDF arrive on its command
  line.

  This fork is a separate product: its own UpgradeCode, install folder, ProgIDs
  (XueLuoPDF.Document) and registry key (Software\XueLuoPDF), so it installs beside an existing
  PdfCraft instead of replacing it. Only the settings folder keeps the upstream name (`PdfCraft`),
  which is where the app reads and writes its preferences and autosaves.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="XueLuoPDF"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="8F3A5C41-6D2B-4E97-9C58-1B7E4D0A63F2"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="XueLuoPDF PDF workbench" Manufacturer="Learning Machines LLC" />
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="XueLuoPDF must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of XueLuoPDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="XueluopdfIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="XueluopdfIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/PLSshenyun/xueluopdf" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/PLSshenyun/xueluopdf" />
    <Property Id="ARPHELPLINK" Value="https://github.com/PLSshenyun/xueluopdf" />
    <!-- Desktop shortcut (#143): on by default, a checkbox in the full-UI welcome dialog, and
         INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended installs. Secure, so the
         choice made in the (unelevated) UI reaches the elevated install. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <!-- "Edit with XueLuoPDF" on the right-click menu of PDF files in File Explorer (#682): on by
         default, the same way, and INSTALLPDFCONTEXTMENU=0 for unattended installs without it. -->
    <Property Id="INSTALLPDFCONTEXTMENU" Value="1" Secure="yes" />
    <UIRef Id="XueluopdfInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="XueLuoPDF">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="XueLuoPDF" Level="1">
      <ComponentGroupRef Id="XueluopdfFiles" />
      <ComponentGroupRef Id="XueluopdfModels" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="XueluopdfFiles" Directory="INSTALLFOLDER">
      <Component Id="XueluopdfApp" Guid="E724C1C6-091F-4E21-A685-80D089FDBE21">
        <File Id="XueluopdfExe" Source="$(var.BinDir)\xueluopdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\xueluopdf.exe" Value="[#XueluopdfExe]" Type="string" />

        <!-- PDF files (#107): XueLuoPDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             XueLuoPDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\XueLuoPDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's lion; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\XueLuoPDF.Document\DefaultIcon" Value="&quot;[#XueluopdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\XueLuoPDF.Document\shell\open\command" Value="&quot;[#XueluopdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="XueLuoPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\xueluopdf.exe" Name="FriendlyAppName" Value="XueLuoPDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\xueluopdf.exe\DefaultIcon" Value="&quot;[#XueluopdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\xueluopdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\xueluopdf.exe\shell\open\command" Value="&quot;[#XueluopdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\XueLuoPDF\Capabilities" Name="ApplicationName" Value="XueLuoPDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\XueLuoPDF\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\XueLuoPDF\Capabilities" Name="ApplicationIcon" Value="[#XueluopdfExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\XueLuoPDF\Capabilities\FileAssociations" Name=".pdf" Value="XueLuoPDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="XueLuoPDF" Value="Software\XueLuoPDF\Capabilities" Type="string" />

        <!-- Image context menu (#190): convert without changing image file defaults. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\XueLuoPDF.CreatePdf" Value="Create PDF with XueLuoPDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\XueLuoPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\XueLuoPDF.CreatePdf\command" Value="&quot;[#XueluopdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to xueluopdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="XueluopdfStartMenuShortcut" Directory="ProgramMenuFolder" Guid="DC028192-C233-4F99-9A77-ED458C60DF26">
        <Shortcut Id="StartMenuShortcut" Name="XueLuoPDF" Description="XueLuoPDF PDF workbench"
            Target="[#XueluopdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="XueluopdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\XueLuoPDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="XueluopdfDesktopShortcut" Directory="DesktopFolder" Guid="F6948627-32AB-4D78-8865-0FDF417CE442"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="XueLuoPDF" Description="XueLuoPDF PDF workbench"
            Target="[#XueluopdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="XueluopdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\XueLuoPDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with XueLuoPDF" opens the file in XueLuoPDF whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="XueluopdfPdfContextMenu" Guid="439F084F-657D-4AC2-A4CC-F099C518D71F"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\XueLuoPDF.Edit" Value="Edit with XueLuoPDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\XueLuoPDF.Edit" Name="Icon" Value="&quot;[#XueluopdfExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\XueLuoPDF.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\XueLuoPDF.Edit\command" Value="&quot;[#XueluopdfExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="XueluopdfCli">
        <File Id="XueluopdfCliExe" Source="$(var.BinDir)\xueluopdf-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="XueluopdfDocumentIconLicense">
        <File Id="XueluopdfDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="XueluopdfMitLicense">
        <File Id="XueluopdfMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="XueluopdfApacheLicense">
        <File Id="XueluopdfApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="XueluopdfNotice">
        <File Id="XueluopdfNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside xueluopdf.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="XueluopdfModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
